#!/usr/bin/env bash
# Fast pre-commit hook for gh-pr-pro.
# Runs module tidy check and static analysis / formatting (golangci-lint).
# Heavy tests, vulnerability scans, and audits are handled in CI/CD.

set -euo pipefail

echo "==> Running fast pre-commit checks (make check-fast)..."
if ! make check-fast; then
    echo ""
    echo "❌ Pre-commit checks failed! Please resolve the errors above before committing."
    echo "   (To bypass in an emergency, use 'git commit --no-verify')"
    exit 1
fi

echo "✅ All pre-commit checks passed successfully."
